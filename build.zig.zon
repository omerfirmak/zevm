        },
        .rlp = .{
            .url = "git+https://github.com/gballet/zig-rlp.git#133352905de96e21e56366f1b09552683199cb23",
            .hash = "rlp-0.1.0-7i0JtIZOAQDsrbKZFe1BHInPdhFqiKRIV2-DNnuRGbMp",
        },
        .ssz = .{
